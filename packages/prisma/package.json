{
	"name": "@just-t/prisma",
	"version": "0.3.0",
	"description": "Prisma-backed messages loader for just-t (optional plugin).",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "pnpm run clean && rolldown -c rolldown.config.mjs && tsc -p tsconfig.build.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"just-t": "workspace:*"
	},
	"peerDependencies": {
		"@prisma/client": ">=6"
	},
	"peerDependenciesMeta": {
		"@prisma/client": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ixexel661/just-t"
	},
	"bugs": {
		"url": "https://github.com/ixexel661/just-t/issues"
	},
	"homepage": "https://github.com/ixexel661/just-t",
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@just-t/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"rolldown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}

